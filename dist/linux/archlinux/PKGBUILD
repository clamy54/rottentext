# Maintainer: Cyril Lamy <root@be-root.com>
#
# Layout identique au .deb, et pour la meme raison: le binaire N'EST PAS dans
# /usr/bin. Le loader cherche syntax/ A COTE de l'executable
# (ExtractFilePath(ParamStr(0))), donc un /usr/bin/rottentext nu irait chercher
# /usr/bin/syntax/. Tout vit dans /usr/lib/rottentext/ et /usr/bin/rottentext
# est un WRAPPER qui fait exec sur le vrai binaire: exec remplace argv[0] par le
# chemin reel. Un lien symbolique ne suffirait PAS, argv[0] resterait
# /usr/bin/rottentext.
#
# Empaquetage non officiellement supporte.

pkgname=rottentext
pkgver=2.0
pkgrel=1
pkgdesc='A rotten editor for rotten files and rotten days'
arch=('x86_64')
url='https://github.com/clamy54/rottentext'
license=('GPL-3.0-or-later')

# Deux familles de dependances, et la seconde est le piege:
#
#  - LIEES au binaire (gtk3): l'editeur de liens les inscrit, namcap les
#    retrouve seul.
#  - ouvertes par DLOPEN (pango, fontconfig): invisibles pour l'editeur de
#    liens comme pour namcap, qui ne lisent que la table des symboles.
#    uFontEmbed (RottenUI) charge libfontconfig.so.1, libpangocairo-1.0.so.0 et
#    libpangoft2-1.0.so.0 a l'execution, pour enregistrer les Monaspace
#    embarquees dans le binaire. gtk3 les tire aujourd'hui de toute facon, mais
#    s'en remettre aux dependances d'un autre paquet est un pari, pas une regle:
#    le jour ou elles changent, c'est notre police qui disparait.
depends=(
  'gtk3'
  'pango'
  'fontconfig'
)

# GTK3 demande Lazarus trunk: aucun paquet ne le livre, lazbuild est donc bati
# ici depuis un commit epingle (meme commit que la CI). fpc suffit pour ca.
# imagemagick sert aux icones redimensionnees.
makedepends=('fpc' 'imagemagick')

# L'archive d'un tag ne contient pas les sous-modules: RottenUI vient a part,
# au commit que le sous-module epingle. A REALIGNER quand il bouge.
_uicommit=1c32c0ed04c8b7ec0875e5a50c9733ff3fbdc7ce
_lazcommit=39a5eec43c6846e8d63cbb6c5fd263db38c4ea5b

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "rottenUI-$_uicommit.tar.gz::https://github.com/clamy54/rottenUI/archive/$_uicommit.tar.gz"
        "lazarus-$_lazcommit.tar.gz::https://gitlab.com/freepascal.org/lazarus/lazarus/-/archive/$_lazcommit/lazarus-$_lazcommit.tar.gz")

# Empreinte de l'archive du tag, pas un SKIP: le tag d'une version publiee ne
# bouge plus. A REGENERER a chaque montee de version (`updpkgsums`), sinon
# makepkg refusera une source pourtant legitime.
sha256sums=('2dc12e506f2f0d9e6922cd33fc4341b95428652b26393ac839ba4a529d332046'
            'SKIP'
            'SKIP')

prepare() {
  rm -rf "$pkgname-$pkgver/rottenui"
  cp -a "rottenUI-$_uicommit" "$pkgname-$pkgver/rottenui"
}

build() {
  cd "$pkgname-$pkgver"

  # Lazarus trunk, config a part: celle de makepkg est neuve et vide, et rien
  # ne doit s'ecrire dans /usr/lib/lazarus. build.sh lit LAZARUS_DIR.
  make -C "$srcdir/lazarus-$_lazcommit" lazbuild
  export PATH="$srcdir/lazarus-$_lazcommit:$PATH"
  export LAZARUS_DIR="$srcdir/lazarus-$_lazcommit"
  export LAZBUILD_PCP="$srcdir/lazcfg"

  bash scripts/build.sh --release
}

package() {
  cd "$pkgname-$pkgver"

  # binaire + donnees runtime, cote a cote (contrainte des loaders)
  install -Dm755 RottenText "$pkgdir/usr/lib/$pkgname/RottenText"
  cp -r syntax "$pkgdir/usr/lib/$pkgname/"
  chmod -R a+rX "$pkgdir/usr/lib/$pkgname/syntax"

  # « $@ » et non rien: c'est lui qui transmet le fichier a ouvrir, celui que le
  # .desktop passe via « %f ».
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/$pkgname" <<'EOF'
#!/bin/sh
exec /usr/lib/rottentext/RottenText "$@"
EOF
  chmod 0755 "$pkgdir/usr/bin/$pkgname"

  # Le .desktop ne declare que des types MIME STANDARD (text/plain, json, xml,
  # yaml): ils sont deja definis par shared-mime-info, il n'y a donc aucun
  # fichier de type a livrer. Aucun script post-installation non plus: pacman
  # regenere les caches desktop et icones par ses propres hooks.
  install -Dm644 dist/linux/rottentext.desktop \
    "$pkgdir/usr/share/applications/$pkgname.desktop"

  # La source n'est PAS carree (629x754): on la met au carre avec du
  # transparent plutot que de la deformer.
  local _s
  for _s in 16 24 32 48 64 128 256; do
    install -d "$pkgdir/usr/share/icons/hicolor/${_s}x${_s}/apps"
    magick icons/rottentext.png -resize "${_s}x${_s}" -background none \
      -gravity center -extent "${_s}x${_s}" \
      "$pkgdir/usr/share/icons/hicolor/${_s}x${_s}/apps/$pkgname.png"
    chmod 0644 "$pkgdir/usr/share/icons/hicolor/${_s}x${_s}/apps/$pkgname.png"
  done

  # Monaspace et JetBrains Mono sont COMPILEES DANS le binaire (RCDATA): l'OFL
  # impose que son texte accompagne meme une distribution binaire seule, d'ou
  # la licence tierce ici et pas seulement le copyright du projet.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE_THIRD_PARTIES.md \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE_THIRD_PARTIES.md"
  install -Dm644 licenses/OFL-1.1-Monaspace.txt \
    "$pkgdir/usr/share/licenses/$pkgname/OFL-1.1-Monaspace.txt"
  install -Dm644 licenses/OFL-1.1-JetBrainsMono.txt \
    "$pkgdir/usr/share/licenses/$pkgname/OFL-1.1-JetBrainsMono.txt"
}
